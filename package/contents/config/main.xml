<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <!-- preferred Easy Effects preset variant when a preset has -min/-max versions -->
    <entry name="variant" type="String"><default>max</default></entry>
    <!-- rank this computer's players above phones bridged by KDE Connect -->
    <entry name="preferLocal" type="Bool"><default>true</default></entry>
    <!-- identity of the player picked by hand in the popup; empty = automatic -->
    <entry name="pinnedPlayer" type="String"><default></default></entry>
    <entry name="compactWidth" type="Int"><default>250</default></entry>
    <!-- panel: 0 cover, title and controls, 1 cover and title, 2 cover and controls -->
    <entry name="compactStyle" type="Int"><default>0</default></entry>
    <!-- popup cover: 0 spinning vinyl, 1 square, 2 round -->
    <entry name="coverStyle" type="Int"><default>0</default></entry>
    <!-- on the desktop: 0 album, 1 wide, 2 vinyl, 3 effects, 4 visualizer -->
    <entry name="deskFace" type="Int"><default>0</default></entry>
    <!-- audio bars on the Visualizer card; needs cava -->
    <entry name="visualizerBars" type="Int"><default>24</default></entry>
    <!-- visualizer look: 0 mirrored from the middle, 1 from the bottom, 2 from the top -->
    <entry name="vizShape" type="Int"><default>0</default></entry>
    <!-- gap between bars and corner roundness, in % of the bar width -->
    <entry name="vizGap" type="Int"><default>35</default></entry>
    <entry name="vizRound" type="Int"><default>50</default></entry>
    <!-- bar color: 0 accent, 1 custom color, 2 gradient (vizColor at the base, vizColor2 at the tip) -->
    <entry name="vizColorMode" type="Int"><default>0</default></entry>
    <entry name="vizColor" type="String"><default>#9b59f6</default></entry>
    <entry name="vizColor2" type="String"><default>#f06bd8</default></entry>
    <entry name="vizPeaks" type="Bool"><default>false</default></entry>
    <entry name="vizShowInfo" type="Bool"><default>true</default></entry>
    <!-- pause timers and animations when windows hide the widget: 0 never, 1 maximized/fullscreen, 2 any window over it -->
    <entry name="pauseWhen" type="Int"><default>1</default></entry>
    <!-- cava: frames per second, smoothing (noise_reduction), sensitivity in %, automatic sensitivity -->
    <entry name="vizFps" type="Int"><default>25</default></entry>
    <entry name="vizSmooth" type="Int"><default>77</default></entry>
    <entry name="vizSens" type="Int"><default>100</default></entry>
    <entry name="vizAutoSens" type="Bool"><default>true</default></entry>
    <!-- Easy Effects presets (group names, without -min/-max) left out of the popup and the Effects card -->
    <entry name="hiddenPresets" type="StringList"><default></default></entry>
    <entry name="accentFromArt" type="Bool"><default>true</default></entry>

    <!-- shared Nyx style (see NyxPresets.js); the default "Theme" look matches Plasma -->
    <entry name="styleShared" type="Bool"><default>true</default></entry>
    <entry name="stylePreset" type="String"><default>theme</default></entry>
    <entry name="styleTint" type="String"><default></default></entry>
    <entry name="styleOpacity" type="Int"><default>85</default></entry>
    <entry name="styleBorder" type="Int"><default>10</default></entry>
    <entry name="styleBorderAccent" type="Bool"><default>false</default></entry>
    <entry name="styleRadius" type="Int"><default>12</default></entry>
    <entry name="styleSheen" type="Int"><default>0</default></entry>
    <entry name="styleShadow" type="Int"><default>0</default></entry>
    <entry name="styleGlow" type="Int"><default>0</default></entry>
    <entry name="styleTextShadow" type="Int"><default>0</default></entry>
    <entry name="styleText" type="String"><default></default></entry>
    <entry name="styleAccent" type="String"><default></default></entry>
    <entry name="styleFont" type="String"><default></default></entry>
    <!-- style form: cards, spacing, number weight, capital labels, number font, motion -->
    <entry name="styleCard" type="String"><default>filled</default></entry>
    <entry name="styleSpace" type="Int"><default>50</default></entry>
    <entry name="styleWeight" type="Int"><default>70</default></entry>
    <entry name="styleCaps" type="Bool"><default>false</default></entry>
    <entry name="styleNumFont" type="String"><default></default></entry>
    <entry name="styleMotion" type="Int"><default>30</default></entry>
    <!-- text: secondary color ("" = text color), its strength, automatic readability fixes -->
    <entry name="styleSubText" type="String"><default></default></entry>
    <entry name="styleSubStrength" type="Int"><default>70</default></entry>
    <entry name="styleAutoContrast" type="Bool"><default>false</default></entry>
  </group>
</kcfg>
